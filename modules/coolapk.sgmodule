#!name=酷安净化
#!desc=去除酷安开屏广告、首页及信息流广告、商品推广（墨鱼 ddgksf2013 规则）
#!author=ddgksf2013
#!category=App净化

[Script]
# > 酷安_开屏广告
coolapk-init = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/main\/init,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js

# > 酷安_首页信息流广告
coolapk-index = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/main\/indexV8,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js

# > 酷安_推广广告
coolapk-data = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/dataList,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js

# > 酷安_评论区广告
coolapk-reply = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/feed\/replyList,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js

# > 酷安_商品推广
coolapk-detail = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/feed\/detail,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js

# > 酷安_酷品页推广
coolapk-page = type=http-response,pattern=^https?:\/\/api\.coolapk\.com\/v6\/page\/dataList\?.*title=%E9%85,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/master/coolapk.js

[URL Rewrite]
# > 酷安_热搜词拦截
^https?:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch - reject-200

[MITM]
hostname = %APPEND% api.coolapk.com
